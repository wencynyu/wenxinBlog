# =====================================================
# WenxinBlog 环境变量示例
# -----------------------------------------------------
# 使用方法: cp .env.example .env ，然后填入真实值。
# .env 已被 .gitignore 忽略，切勿提交真实密钥。
# docker-compose 会自动读取同目录下的 .env。
# =====================================================

# ---- PostgreSQL（本地开发默认 postgres）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis（本地开发默认空/redis）----
REDIS_PASSWORD=redis

# ---- RabbitMQ（本地开发默认 guest/admin）----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- MinIO / OSS（本地开发默认 minioadmin）----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- JWT 密钥（生产必须为强随机串，无默认值时服务启动失败）----
# 生成示例: openssl rand -base64 48
JWT_SECRET=

# ---- OAuth（按需填写，留空则关闭对应登录方式）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- 前端（Web）----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_OSS_URL=
