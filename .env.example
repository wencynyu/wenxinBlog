# =====================================================
# WenxinBlog 环境变量示例
# -----------------------------------------------------
# 使用方法: cp .env.example .env ，然后填入真实值。
# .env 已被 .gitignore 忽略，切勿提交真实密钥。
# docker-compose 会自动读取同目录下的 .env。
# =====================================================

# ---- PostgreSQL（本地开发默认 postgres）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis（本地开发默认空/redis）----
REDIS_PASSWORD=redis

# ---- MinIO / OSS（本地开发默认 minioadmin）----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- JWT 密钥（生产必须为强随机串，无默认值时服务启动失败）----
# 生成示例: openssl rand -base64 48
JWT_SECRET=

# ---- OAuth（按需填写，留空则关闭对应登录方式）----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# provider 回调地址（须与 Google Cloud Console「授权回调」登记完全一致）。
# 默认打到后端经网关，由后端换取 code 后再 302 回前端。
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback/google

# ---- 短信（手机号验证码登录）----
# provider: mock（本地打印验证码，不真实发送）/ aliyun（需配 AccessKey/签名/模板）
SMS_PROVIDER=mock
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ---- OAuth 回调 / 前端地址 ----
# 后端换取 token 后 302 跳回的前端地址（浏览器可见地址）
FRONTEND_URL=http://localhost:3000

# ---- 前端（Web）----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_OSS_URL=
