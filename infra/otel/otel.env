# =====================================================
# 共享 OTel 配置（docker compose 模式，挂在 x-java-defaults 上）
# -----------------------------------------------------
# OTLP → otel-collector:4317（gRPC）。Collector 同在 wenxinblog 网络。
#
# - Java 服务：由 OTel Java Agent（-javaagent，已烧进 Dockerfile ENTRYPOINT）读取。
#   OTEL_INSTRUMENTATION_MICROMETER_ENABLED 把现有 Micrometer 指标桥接到 OTLP。
# - Go 服务：由 OTel SDK 读取（grpc exporter，见各服务 main.go）。
# - web（Node）：忽略这些变量，无副作用。
# - OTEL_SERVICE_NAME 各服务在自身 environment 单独设置。
# =====================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true
