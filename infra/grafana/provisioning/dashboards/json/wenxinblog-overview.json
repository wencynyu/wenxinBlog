{
  "title": "WenxinBlog 服务监控",
  "tags": ["wenxinblog"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, service)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "JVM Heap 内存",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\", service=~\"$service\"}) by (service)",
          "legendFormat": "{{service}} used"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\", service=~\"$service\"}) by (service)",
          "legendFormat": "{{service}} max"
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM 非 Heap 内存",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\", service=~\"$service\"}) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 请求速率 (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=~\"$service\"}[1m])) by (service) or sum(rate(http_requests_total{service=~\"$service\"}[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 平均延迟 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{service=~\"$service\"}[1m]) / rate(http_server_requests_seconds_count{service=~\"$service\"}[1m]) * 1000",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM GC 暂停时间 (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{service=~\"$service\"}[1m]) * 1000",
          "legendFormat": "{{service}} {{action}} {{cause}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM 线程数",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_threads_live_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} live"
        },
        {
          "expr": "jvm_threads_states_threads{service=~\"$service\"}",
          "legendFormat": "{{service}} {{state}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "进程 CPU 使用率 (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{service=~\"$service\"} * 100",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "服务健康状态",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "UP", "color": "green" },
                "0": { "text": "DOWN", "color": "red" }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "up{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
