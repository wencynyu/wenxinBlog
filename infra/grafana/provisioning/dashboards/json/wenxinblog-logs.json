{
  "uid": "wenxinblog-logs",
  "title": "WenxinBlog Logs",
  "tags": ["otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
        "query": "{\"find\": \"terms\", \"field\": \"service.name\", \"size\": 20}",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "severity",
        "type": "query",
        "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
        "query": "{\"find\": \"terms\", \"field\": \"severity_text\", \"size\": 10}",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": "*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "type": "textbox",
        "query": "*",
        "current": { "text": "*", "value": "*" },
        "label": "内容搜索"
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "日志量趋势（按服务）",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
          "query": "service.name:$service AND severity_text:$severity",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service.name",
              "settings": {
                "size": "10",
                "min_doc_count": "0",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": { "interval": "auto", "min_doc_count": "0" }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "日志按服务分布",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
      "gridPos": { "x": 0, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
          "query": "service.name:$service AND severity_text:$severity",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service.name",
              "settings": {
                "size": "10",
                "min_doc_count": "0",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ]
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "values": false, "fields": "" },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "按级别分布",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
      "gridPos": { "x": 8, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
          "query": "service.name:$service AND severity_text:$severity",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "severity_text",
              "settings": {
                "size": "10",
                "min_doc_count": "0",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ]
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "values": false, "fields": "" },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "日志总数",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
      "gridPos": { "x": 16, "y": 7, "w": 8, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
          "query": "service.name:$service AND severity_text:$severity",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "count" }],
          "bucketAggs": []
        }
      ],
      "options": { "reduceOptions": { "calcs": ["sum"], "fields": "" } }
    },
    {
      "id": 1,
      "type": "logs",
      "title": "日志流",
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 10 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-logs" },
          "query": "service.name:$service AND severity_text:$severity",
          "timeField": "@timestamp",
          "metrics": [{ "id": "1", "type": "logs" }],
          "bucketAggs": []
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "labels": ["service.name", "severity_text", "scope.name"]
      }
    }
  ]
}
