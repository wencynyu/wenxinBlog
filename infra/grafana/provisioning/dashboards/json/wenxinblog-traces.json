{
  "uid": "wenxinblog-traces",
  "title": "WenxinBlog Traces",
  "tags": ["otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "elasticsearch-traces"
        },
        "query": "{\"find\": \"terms\", \"field\": \"trace_id\", \"size\": 20, \"order\": \"desc\", \"orderBy\": \"_count\"}",
        "refresh": 1,
        "includeAll": true,
        "allValue": "*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Span 吞吐趋势（按服务）",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch-traces"
          },
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service.name",
              "settings": {
                "size": "10",
                "min_doc_count": "0",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "链路时序（近似）：选 trace 查看该链路所有 span，按时间排序（无父子层级，近似替代瀑布图）",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch-traces"
          },
          "query": "trace_id:$trace",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "500"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        }
      },
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "alias": "耗时(ms)",
            "mode": "binary",
            "operation": "divide",
            "binary": {
              "left": "duration",
              "right": "constant",
              "constant": 1000000
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "name",
                "resource.attributes.service.name",
                "kind",
                "耗时(ms)",
                "parent_span_id",
                "span_id",
                "trace_id"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "@timestamp",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "@timestamp": "时间",
              "name": "操作",
              "resource.attributes.service.name": "服务",
              "kind": "类型",
              "耗时(ms)": "耗时(ms)",
              "parent_span_id": "父span",
              "span_id": "span_id",
              "trace_id": "trace_id"
            },
            "indexByName": {
              "@timestamp": 0,
              "name": 1,
              "resource.attributes.service.name": 2,
              "kind": 3,
              "耗时(ms)": 4,
              "parent_span_id": 5,
              "span_id": 6,
              "trace_id": 7
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Span 按服务分布",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch-traces"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch-traces"
          },
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "service.name",
              "settings": {
                "size": "10",
                "min_doc_count": "0",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "values": false,
          "fields": ""
        },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Span 按类型分布（SERVER / CLIENT / INTERNAL）",
      "datasource": {
        "type": "elasticsearch",
        "uid": "elasticsearch-traces"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "elasticsearch-traces"
          },
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "kind",
              "settings": {
                "size": "10",
                "min_doc_count": "0",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "values": false,
          "fields": ""
        },
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      }
    }
  ]
}
